/target
Cargo.lock

# ==============================================================================
# OS-Specific System Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# ==============================================================================
# Common Development Junk (Optional but recommended)
# ==============================================================================
# IDEs and Text Editors
.vscode/
.idea/
*.swp
*.swo

# Log files and temporary files
*.log
*.tmp
*.bak

# Generated by Cargo
# Contains compiled files, build artifacts, and executables
/target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# rustc will dump stack traces here when hitting an internal compiler error
rustc-ice-*.txt

# Cargo mutants testing data (if you use cargo-mutants)
**/mutants.out/
